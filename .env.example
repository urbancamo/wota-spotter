# Database URLs
WOTA_DATABASE_URL="mysql://user:password@host/wota_database"
CMS_DATABASE_URL="mysql://user:password@host/cms_database"

# Data API base URL (for wota-data API)
# Uses Vite proxy in development (see vite.config.ts)
# Production: /data/api
VITE_DATA_API_BASE_URL="/data/api"

# Proxy target for data API (used by Vite dev server)
DATA_API_PROXY_TARGET="http://localhost:3003"
